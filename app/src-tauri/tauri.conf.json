{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "River Writer",
  "version": "0.1.0",
  "identifier": "dev.riverwriter.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "River Writer",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "resources": ["../../fonts/courier-prime/OFL.txt", "../../LICENSE"]
  }
}
