{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "River Writer",
  "version": "0.1.0",
  "identifier": "app.riverwriter.mac",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "River Writer",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": ["../../fonts/courier-prime/OFL.txt", "../../LICENSE"],
    "category": "Productivity",
    "copyright": "Copyright \u00a9 2026 River Writer contributors. MIT License.",
    "shortDescription": "Offline writing app for screenplays, stage plays and novels.",
    "fileAssociations": [
      {
        "ext": ["fountain"],
        "name": "Fountain Screenplay",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": ["net.daringfireball.markdown"]
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    }
  }
}
